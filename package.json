{
  "name": "solver-ai",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=22.21 <25"
  },
  "scripts": {
    "dev": "python3 scripts/dev.py",
    "dev:web": "npm run dev --workspace @solver-ai/web",
    "build": "npm run build --workspace @solver-ai/web && node scripts/check-standalone.mjs",
    "start:web": "npm run start --workspace @solver-ai/web",
    "typecheck": "npm run typecheck --workspace @solver-ai/web",
    "test:api": "uv run --project services/api --frozen pytest services/api/tests",
    "test:e2e": "playwright test",
    "test": "npm run test:api && npm run test:auth && npm run test:judge && npm run typecheck && npm run test:e2e",
    "dev:judge": "python3 scripts/dev.py --judge",
    "auth:migrate": "node apps/web/scripts/auth-migrate.mjs",
    "test:auth": "node --test apps/web/tests/auth.test.mjs",
    "judge:build": "docker build -t solver-ai-sandbox:local services/judge",
    "judge:build:cloud": "docker build --secret id=proxy_ca,src=/etc/ssl/certs/ca-certificates.crt -t solver-ai-sandbox:local services/judge",
    "judge:worker": "python3 scripts/judge-worker.py",
    "test:judge": "uv run --project services/api --frozen pytest services/judge/tests",
    "test:judge:integration": "SOLVER_JUDGE_INTEGRATION=1 uv run --project services/api --frozen pytest services/judge/tests",
    "test:e2e:judge": "SOLVER_E2E_JUDGE=1 playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0"
  },
  "overrides": {
    "dompurify": "3.4.17"
  }
}
